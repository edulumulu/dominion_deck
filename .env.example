# Credenciales de la base de datos PostgreSQL
# Genera una contraseña segura: openssl rand -base64 32
DB_USER=dominion
DB_NAME=dominion
DB_PASSWORD=

# URL de conexión (usada por el backend)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# Orígenes permitidos para CORS (tu dominio de producción)
# Ejemplo: https://dominion.tudominio.com
CORS_ORIGINS=http://localhost
